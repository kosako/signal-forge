<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  朝バッチ(設計 05 §1.1)。__PLACEHOLDER__ は ops/runbook.md の手順で置換してから
  ~/Library/LaunchAgents/ へ「コピー」して bootstrap する(symlink 不可)。
  - 自動再実行しない(KeepAlive なし): 失敗時は watchdog 通知 → 手動 `intel run` 再走
  - EnvironmentVariables は PATH/HOME のみ。ANTHROPIC_API_KEY を絶対に入れない
  - PATH には uv(起動)に加え codex(analyze で subprocess 起動)の dir(__CODEX_DIR__)を
    必ず含める。抜けると analyze が全チャンク「codex not found」で degraded になる(#72)
  - 時刻はシステムのローカルタイムゾーン(JST 前提)。配信時刻(宿題 H5)確定時は
    Hour/Minute と pmset wake を合わせて更新する
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.intel.morning</string>
  <key>ProgramArguments</key>
  <array>
    <string>__UV_BIN__</string>
    <string>run</string>
    <string>intel</string>
    <string>run</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO_DIR__</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:__UV_DIR__:__CODEX_DIR__</string>
    <key>HOME</key>
    <string>__HOME__</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/.local/state/intel/logs/morning-launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.local/state/intel/logs/morning-launchd.log</string>
</dict>
</plist>
